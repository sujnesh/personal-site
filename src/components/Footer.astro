---
import { SITE_EMAIL, SITE_OWNER } from '../consts';
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} {SITE_OWNER}. All rights reserved.</p>
	<p>
		<a href={`mailto:${SITE_EMAIL}`}>{SITE_EMAIL}</a>
	</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	footer p {
		margin: 0.2rem 0;
	}
	footer a {
		text-decoration: none;
		color: rgb(var(--gray));
	}
	footer a:hover {
		color: rgb(var(--gray-dark));
	}
</style>
