---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: min(100% - 32px, 860px);
			}

			ul {
				display: grid;
				gap: 1rem;
				list-style-type: none;
				margin: 2rem 0 0;
				padding: 0;
			}

			ul li {
				padding: 1.1rem;
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--panel);
			}

			ul li a {
				display: inline-block;
				font-size: 1.25rem;
				font-weight: 700;
				text-decoration: none;
			}

			.description {
				margin: 0.4rem 0;
			}

			.date {
				margin: 0.2rem 0 0;
				color: var(--muted);
				font-size: 0.95rem;
			}

			.empty {
				margin-top: 2rem;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<p class="eyebrow">Blog</p>
				<h1>Notes and build logs.</h1>
				<p class="lede">Short writeups will live here once they are useful enough to keep.</p>
				{
					posts.length > 0 ? (
						<ul>
							{posts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>{post.data.title}</a>
									<p class="description">{post.data.description}</p>
									<p class="date"><FormattedDate date={post.data.pubDate} /></p>
								</li>
							))}
						</ul>
					) : (
						<div class="empty">
							<h2>No published notes yet.</h2>
							<p>For now, the useful material is in the work index and learning log.</p>
						</div>
					)
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
