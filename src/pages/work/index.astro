---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.list {
				display: grid;
				gap: 1rem;
			}
			.item {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1rem;
			}
			.item h2 {
				font-size: 1.2rem;
				margin: 0;
			}
			.item h2 a {
				text-decoration: none;
			}
			.meta {
				margin: 0.35rem 0;
				font-size: 0.95rem;
				color: rgb(var(--gray));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin-top: 0.6rem;
			}
			.tag {
				font-size: 0.8rem;
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Work</h1>
			<p>Projects, experiments, and product notes.</p>

			<section class="list">
				{
					projects.map((project) => (
						<article class="item">
							<h2>
								<a href={`/work/${project.id}/`}>{project.data.title}</a>
							</h2>
							<p class="meta">
								<FormattedDate date={project.data.pubDate} /> · {project.data.status}
							</p>
							<p>{project.data.description}</p>
							{project.data.tags.length > 0 && (
								<div class="tags">
									{project.data.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							)}
						</article>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
