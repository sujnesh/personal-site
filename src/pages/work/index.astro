---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Work | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.hero-copy {
				max-width: 760px;
				margin-bottom: 2.5rem;
			}

			.work-list {
				display: grid;
				gap: 1rem;
			}

			.work-item {
				display: grid;
				grid-template-columns: 1fr auto;
				gap: 1rem;
				color: inherit;
				text-decoration: none;
			}

			.work-item:hover {
				border-color: var(--accent);
			}

			.status {
				align-self: start;
				color: var(--warm);
				font-size: 0.8rem;
				font-weight: 800;
				text-transform: uppercase;
			}

			@media (max-width: 700px) {
				.work-item {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero-copy">
				<p class="eyebrow">Work</p>
				<h1>Open projects and public product experiments.</h1>
				<p class="lede">
					AI infrastructure, coaching products, endurance tools, and developer workflows. The public work here
					sits next to my production platform work in monetization, lead generation, and recommendations.
				</p>
			</section>

			<section class="work-list">
				{
					projects.map((project) => (
						<a class="card work-item" href={`/work/${project.id}/`}>
							<div>
								<h2>{project.data.title}</h2>
								<p class="meta">
									{project.data.area ? `${project.data.area} · ` : ''}
									<FormattedDate date={project.data.pubDate} />
								</p>
								<p>{project.data.description}</p>
								{project.data.tags.length > 0 && (
									<div class="tags">
										{project.data.tags.map((tag) => (
											<span class="tag">{tag}</span>
										))}
									</div>
								)}
							</div>
							<span class="status">{project.data.status}</span>
						</a>
					))
				}
			</section>
		</main>
		<Footer />
	</body>
</html>
