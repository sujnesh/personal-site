---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_GITHUB, SITE_LINKEDIN, SITE_OWNER, SITE_TITLE, SITE_X } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

type Props = {
	project: CollectionEntry<'projects'>;
};

const { project } = Astro.props as Props;
const { Content } = await render(project);
const projectUrl = new URL(`/work/${project.id}/`, Astro.site).href;
const projectImage = project.data.videoThumbUrl ? new URL(project.data.videoThumbUrl, Astro.site).href : undefined;
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': project.data.repoUrl ? 'SoftwareSourceCode' : 'CreativeWork',
		name: project.data.title,
		description: project.data.description,
		url: projectUrl,
		image: projectImage,
		datePublished: project.data.pubDate.toISOString(),
		dateModified: (project.data.updatedDate ?? project.data.pubDate).toISOString(),
		keywords: project.data.tags.join(', '),
		codeRepository: project.data.repoUrl,
		author: {
			'@type': 'Person',
			name: SITE_OWNER,
			url: new URL('/', Astro.site).href,
			sameAs: [SITE_GITHUB, SITE_LINKEDIN, SITE_X],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'BreadcrumbList',
		itemListElement: [
			{
				'@type': 'ListItem',
				position: 1,
				name: 'Work',
				item: new URL('/work/', Astro.site).href,
			},
			{
				'@type': 'ListItem',
				position: 2,
				name: project.data.title,
				item: projectUrl,
			},
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`${project.data.title} by ${SITE_OWNER} | ${SITE_TITLE}`}
			description={project.data.description}
			image={project.data.videoThumbUrl}
			imageAlt={`${project.data.title} project by ${SITE_OWNER}`}
			jsonLd={jsonLd}
		/>
		<style>
			main {
				width: min(100% - 32px, 900px);
			}

			.back {
				display: inline-block;
				margin-bottom: 1.6rem;
				font-weight: 800;
				text-decoration: none;
			}

			.project-head {
				margin-bottom: 2rem;
				padding-bottom: 2rem;
				border-bottom: 1px solid var(--line);
			}

			.project-head h1 {
				font-size: 3.5rem;
			}

			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-top: 1.2rem;
			}

			.video-shell {
				position: relative;
				display: block;
				aspect-ratio: 9 / 16;
				max-width: 360px;
				margin: 0 auto 2rem;
				padding: 0.65rem;
				border: 1px solid var(--line);
				border-radius: 28px;
				background: #050706;
				box-shadow: 0 20px 70px rgba(23, 25, 31, 0.18);
				overflow: hidden;
			}

			.video-shell img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 20px;
			}

			.play-mark {
				position: absolute;
				left: 50%;
				top: 50%;
				display: grid;
				width: 74px;
				height: 74px;
				place-items: center;
				border-radius: 999px;
				background: rgba(14, 18, 13, 0.86);
				transform: translate(-50%, -50%);
			}

			.play-mark::before {
				margin-left: 5px;
				border-top: 14px solid transparent;
				border-bottom: 14px solid transparent;
				border-left: 22px solid white;
				content: "";
			}

			@media (max-width: 640px) {
				.project-head h1 {
					font-size: 2.4rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/work">Back to work</a>
			<section class="project-head">
				<p class="eyebrow">{project.data.status}</p>
				<h1>{project.data.title}</h1>
				<p class="lede">{project.data.description}</p>
				<p class="meta">
					{project.data.area ? `${project.data.area} · ` : ''}
					<FormattedDate date={project.data.pubDate} />
				</p>
				{project.data.tags.length > 0 && (
					<div class="tags">
						{project.data.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
				)}
				{(project.data.repoUrl || project.data.demoUrl || project.data.socialUrl) && (
					<div class="links">
						{project.data.repoUrl && (
							<a class="button secondary" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
								Repository
							</a>
						)}
						{project.data.demoUrl && (
							<a class="button secondary" href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">
								Demo
							</a>
						)}
						{project.data.socialUrl && (
							<a class="button secondary" href={project.data.socialUrl} target="_blank" rel="noopener noreferrer">
								X post
							</a>
						)}
					</div>
				)}
			</section>
			{project.data.videoThumbUrl && project.data.demoUrl && (
				<a class="video-shell" href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Play ${project.data.title} demo`}>
					<img src={project.data.videoThumbUrl} alt={`${project.data.title} demo poster`} width="552" height="1200" />
					<span class="play-mark" aria-hidden="true"></span>
				</a>
			)}
			<article class="prose">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>
