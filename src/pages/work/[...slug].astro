---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.id },
		props: { project },
	}));
}

type Props = {
	project: CollectionEntry<'projects'>;
};

const { project } = Astro.props as Props;
const { Content } = await render(project);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${project.data.title} | ${SITE_TITLE}`} description={project.data.description} />
		<style>
			main {
				width: 780px;
			}
			.meta {
				color: rgb(var(--gray));
				margin-bottom: 0.6rem;
			}
			.links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin-bottom: 1rem;
			}
			.button {
				font-size: 0.9rem;
				padding: 0.3rem 0.7rem;
				border-radius: 6px;
				text-decoration: none;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				gap: 0.4rem;
				margin: 0.8rem 0 1.2rem;
			}
			.tag {
				font-size: 0.8rem;
				padding: 0.15rem 0.5rem;
				border-radius: 999px;
				background: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
			}
			.prose {
				margin-top: 1rem;
			}
			.back {
				display: inline-block;
				margin-bottom: 1rem;
				text-decoration: none;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a class="back" href="/work">← Back to work</a>
			<h1>{project.data.title}</h1>
			<p class="meta">
				<FormattedDate date={project.data.pubDate} /> · {project.data.status}
			</p>
			<p>{project.data.description}</p>
			{(project.data.repoUrl || project.data.demoUrl) && (
				<div class="links">
					{project.data.repoUrl && (
						<a class="button" href={project.data.repoUrl} target="_blank" rel="noopener noreferrer">
							Repository
						</a>
					)}
					{project.data.demoUrl && (
						<a class="button" href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">
							Live Demo
						</a>
					)}
				</div>
			)}
			{project.data.tags.length > 0 && (
				<div class="tags">
					{project.data.tags.map((tag) => (
						<span class="tag">{tag}</span>
					))}
				</div>
			)}
			<article class="prose">
				<Content />
			</article>
		</main>
		<Footer />
	</body>
</html>
