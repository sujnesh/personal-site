---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				margin-bottom: 2rem;
			}
			.hero h1 {
				margin-bottom: 0.75rem;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, minmax(0, 1fr));
				gap: 1rem;
				margin-top: 2rem;
			}
			.card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 10px;
				padding: 1rem;
				text-decoration: none;
				color: rgb(var(--gray-dark));
				transition: 0.2s ease;
			}
			.card h2 {
				font-size: 1.2rem;
				margin: 0 0 0.3rem 0;
			}
			.card p {
				margin: 0;
			}
			.card:hover {
				border-color: var(--accent);
				box-shadow: 0 8px 24px rgba(var(--gray), 20%);
			}
			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, I am Sujnesh.</h1>
				<p>
					Welcome to my corner of the internet. I use this website to share my work, publish blog posts, and
					document what I am learning.
				</p>
				<p>
					This Astro setup is intentionally simple so you can keep publishing quickly. Update any section as
					your interests evolve.
				</p>
			</section>

			<section class="grid">
				<a class="card" href="/work">
					<h2>Work</h2>
					<p>Projects, case studies, and things I have built.</p>
				</a>
				<a class="card" href="/blog">
					<h2>Blog</h2>
					<p>Notes, essays, and updates from my journey.</p>
				</a>
				<a class="card" href="/learnings">
					<h2>Learnings</h2>
					<p>Books, tools, and concepts I am currently exploring.</p>
				</a>
				<a class="card" href="/about">
					<h2>About</h2>
					<p>Who I am, what I care about, and how to contact me.</p>
				</a>
			</section>
		</main>
		<Footer />
	</body>
</html>
