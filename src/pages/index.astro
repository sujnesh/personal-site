---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	SITE_DESCRIPTION,
	SITE_EMAIL,
	SITE_GITHUB,
	SITE_LINKEDIN,
	SITE_OWNER,
	SITE_TITLE,
	SITE_X,
} from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredIds = ['repwise', 'tokenops', 'zone2coach'];
const featuredProjects = featuredIds
	.map((id) => projects.find((project) => project.id === id))
	.filter((project) => project !== undefined);
const repwise = projects.find((project) => project.id === 'repwise');
const siteUrl = new URL('/', Astro.site).href;
const sameAs = [SITE_GITHUB, SITE_LINKEDIN, SITE_X];
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		name: `${SITE_OWNER} - Lead Backend Engineer and Applied AI Builder`,
		url: siteUrl,
		description: SITE_DESCRIPTION,
		mainEntity: {
			'@type': 'Person',
			name: SITE_OWNER,
			url: siteUrl,
			email: `mailto:${SITE_EMAIL}`,
			jobTitle: 'Lead Software Development Engineer',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Noida',
				addressCountry: 'IN',
			},
			sameAs,
			knowsAbout: [
				'Backend platforms',
				'Applied AI systems',
				'LLM gateways',
				'Recommendation systems',
				'Product engineering',
			],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: siteUrl,
		description: SITE_DESCRIPTION,
		author: {
			'@type': 'Person',
			name: SITE_OWNER,
			url: siteUrl,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: 'Sujnesh Mishra project shortlist',
		itemListElement: featuredProjects.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: new URL(`/work/${project.id}/`, Astro.site).href,
			name: project.data.title,
			description: project.data.description,
		})),
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Sujnesh Mishra | Lead Backend Engineer & Applied AI Builder"
			description={SITE_DESCRIPTION}
			image="/repwise-live.jpg"
			imageAlt="RepWise AI workout coach demo by Sujnesh Mishra"
			jsonLd={jsonLd}
		/>
		<style>
			main {
				width: min(100% - 32px, var(--page));
				padding-top: 0;
			}

			.hero {
				position: relative;
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(300px, 380px);
				gap: 3rem;
				align-items: center;
				min-height: calc(100vh - 72px);
				margin: 0 calc(50% - 50vw);
				padding: 4rem max(1rem, calc((100vw - var(--page)) / 2));
				background:
					linear-gradient(90deg, rgba(230, 255, 54, 0.1) 1px, transparent 1px),
					linear-gradient(180deg, rgba(230, 255, 54, 0.08) 1px, transparent 1px),
					#0e120d;
				background-size: 42px 42px;
				color: white;
				overflow: hidden;
			}

			.hero::after {
				position: absolute;
				top: 0;
				right: 0;
				width: min(16vw, 180px);
				height: 100%;
				background:
					linear-gradient(180deg, #e6ff36, #f59e0b 48%, #8ee0d1),
					#e6ff36;
				content: "";
				mix-blend-mode: screen;
				opacity: 0.82;
			}

			.hero-copy,
			.demo-stage {
				position: relative;
				z-index: 1;
			}

			.hero h1 {
				max-width: 920px;
				color: white;
				font-size: clamp(3.4rem, 9vw, 7.2rem);
				line-height: 0.95;
			}

			.hero h1 span {
				color: #e6ff36;
			}

			.hero p {
				color: #dce3e1;
			}

			.hero .lede {
				max-width: 700px;
				margin-top: 1rem;
				color: #f4f7f3;
			}

			.terminal-line {
				display: inline-flex;
				max-width: 100%;
				margin-bottom: 1.2rem;
				padding: 0.35rem 0.55rem;
				border: 1px solid rgba(230, 255, 54, 0.36);
				background: rgba(0, 0, 0, 0.28);
				color: #e6ff36;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.82rem;
				font-weight: 800;
				overflow-wrap: anywhere;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: 1.5rem;
			}

			.hero .button {
				border-color: #e6ff36;
				background: #e6ff36;
				color: #11130f;
			}

			.hero .button.secondary {
				border-color: rgba(255, 255, 255, 0.65);
				background: transparent;
				color: white;
			}

			.status-strip {
				display: grid;
				grid-template-columns: repeat(4, minmax(0, 1fr));
				gap: 1px;
				margin-top: 2rem;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.16);
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.16);
			}

			.status-strip div {
				padding: 0.9rem;
				background: rgba(13, 18, 15, 0.82);
			}

			.status-strip span {
				display: block;
				color: #8ee0d1;
				font-size: 0.72rem;
				font-weight: 900;
				text-transform: uppercase;
			}

			.status-strip strong {
				display: block;
				margin-top: 0.3rem;
				color: white;
				font-size: 1.1rem;
				line-height: 1.2;
			}

			.demo-stage {
				justify-self: end;
				width: min(100%, 360px);
			}

			.window-label {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 0.55rem 0.75rem;
				border: 1px solid rgba(255, 255, 255, 0.2);
				border-bottom: 0;
				border-radius: 8px 8px 0 0;
				background: #17191f;
				color: #e6ff36;
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.78rem;
				font-weight: 800;
			}

			.phone-shell {
				position: relative;
				display: block;
				aspect-ratio: 9 / 16;
				padding: 0.65rem;
				border: 1px solid rgba(255, 255, 255, 0.24);
				border-radius: 0 0 28px 28px;
				background: #050706;
				box-shadow: 0 28px 90px rgba(0, 0, 0, 0.42);
				overflow: hidden;
			}

			.phone-shell img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				border-radius: 0 0 20px 20px;
			}

			.play-mark {
				position: absolute;
				left: 50%;
				top: 50%;
				display: grid;
				width: 74px;
				height: 74px;
				place-items: center;
				border-radius: 999px;
				background: rgba(14, 18, 13, 0.86);
				transform: translate(-50%, -50%);
			}

			.play-mark::before {
				margin-left: 5px;
				border-top: 14px solid transparent;
				border-bottom: 14px solid transparent;
				border-left: 22px solid white;
				content: "";
			}

			.demo-note {
				margin-top: 1rem;
				padding: 1rem;
				border: 1px solid rgba(255, 255, 255, 0.18);
				border-radius: 8px;
				background: rgba(255, 255, 255, 0.08);
			}

			.demo-note h2 {
				color: white;
				font-size: 1.15rem;
			}

			.demo-note p {
				margin: 0;
				color: #d7e0de;
				font-size: 0.95rem;
			}

			.demo-links {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				margin-top: 0.8rem;
			}

			.demo-links a {
				color: #e6ff36;
				font-size: 0.9rem;
				font-weight: 900;
				text-decoration: none;
			}

			.shelf {
				padding: 4.5rem 0;
			}

			.shortlist {
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--panel);
				overflow: hidden;
			}

			.shortlist a {
				display: grid;
				grid-template-columns: 58px minmax(0, 1fr) auto auto;
				gap: 1rem;
				align-items: center;
				padding: 1.2rem;
				border-bottom: 1px solid var(--line);
				color: inherit;
				text-decoration: none;
			}

			.shortlist a:last-child {
				border-bottom: 0;
			}

			.shortlist a:hover {
				background: #f5fb41;
			}

			.shortlist .number,
			.shortlist .area {
				color: var(--muted);
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.82rem;
				font-weight: 800;
				text-transform: uppercase;
			}

			.shortlist h3 {
				margin-bottom: 0.2rem;
				font-size: 1.55rem;
			}

			.shortlist p {
				margin: 0;
			}

			.arrow {
				color: var(--accent-strong);
				font-size: 1.5rem;
				font-weight: 900;
			}

			.field-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
				padding-bottom: 4.5rem;
			}

			.panel {
				padding: 1.25rem;
				border: 1px solid var(--ink);
				border-radius: 8px;
				background: var(--panel);
			}

			.panel.dark {
				background: var(--ink);
			}

			.panel.dark h2,
			.panel.dark p {
				color: white;
			}

			.now-list {
				display: grid;
				gap: 0.75rem;
				margin-top: 1rem;
			}

			.now-list div {
				display: grid;
				grid-template-columns: 120px 1fr;
				gap: 1rem;
				padding-top: 0.75rem;
				border-top: 1px solid rgba(255, 255, 255, 0.16);
			}

			.now-list span {
				color: #8ee0d1;
				font-size: 0.8rem;
				font-weight: 900;
				text-transform: uppercase;
			}

			.note-strip {
				display: grid;
				grid-template-columns: 1.1fr 1fr;
				gap: 1rem;
				padding: 1.4rem;
				border-radius: 8px;
				background: #f59e0b;
				color: #11130f;
			}

			.note-strip h2,
			.note-strip p {
				color: #11130f;
			}

			.note-strip a {
				color: #11130f;
				font-weight: 900;
			}

			@media (max-width: 900px) {
				.hero,
				.field-grid,
				.note-strip {
					grid-template-columns: 1fr;
				}

				.hero::after {
					width: 16px;
				}

				.demo-stage {
					justify-self: start;
					width: min(100%, 330px);
				}

				.status-strip {
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}
			}

			@media (max-width: 640px) {
				.hero {
					padding-top: 3rem;
					padding-bottom: 3rem;
				}

				.status-strip,
				.shortlist a,
				.now-list div {
					grid-template-columns: 1fr;
				}

				.shortlist .area,
				.arrow {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<div class="hero-copy">
					<p class="terminal-line">sujnesh://now &gt; backend-platforms + applied-ai</p>
					<h1>Sujnesh Mishra builds software with a <span>pulse</span>.</h1>
					<p class="lede">
						I am Sujnesh Mishra, a lead backend engineer building monetization platforms, recommendation
						systems, LLM gateways, and AI coaching products. This site is my public workbench.
					</p>
					<div class="actions">
						{repwise?.data.demoUrl && <a class="button" href={repwise.data.demoUrl} target="_blank" rel="noopener noreferrer">Watch RepWise</a>}
						<a class="button secondary" href="/work">Open shelf</a>
						<a class="button secondary" href={`mailto:${SITE_EMAIL}`}>Email</a>
					</div>
					<div class="status-strip" aria-label="Career highlights">
						<div>
							<span>Role</span>
							<strong>Lead backend engineer</strong>
						</div>
						<div>
							<span>Focus</span>
							<strong>Applied AI systems</strong>
						</div>
						<div>
							<span>Building</span>
							<strong>TokenOps + RepWise</strong>
						</div>
						<div>
							<span>Base</span>
							<strong>Noida, India</strong>
						</div>
					</div>
				</div>
				{repwise?.data.demoUrl && repwise.data.videoThumbUrl && (
					<aside class="demo-stage" id="repwise-demo" aria-label="RepWise demo">
						<div class="window-label">
							<span>repwise.short</span>
							<span>live demo</span>
						</div>
						<a class="phone-shell" href={repwise.data.demoUrl} target="_blank" rel="noopener noreferrer">
							<img src={repwise.data.videoThumbUrl} alt="RepWise app demo showing pose tracking during a workout" width="552" height="1200" />
							<span class="play-mark" aria-hidden="true"></span>
						</a>
						<div class="demo-note">
							<p class="eyebrow">RepWise</p>
							<h2>AI workout coaching in motion.</h2>
							<p>Click the phone for the full YouTube Short. The X post has the screenshot thread.</p>
							<div class="demo-links">
								<a href={repwise.data.demoUrl} target="_blank" rel="noopener noreferrer">YouTube Short</a>
								{repwise.data.socialUrl && (
									<a href={repwise.data.socialUrl} target="_blank" rel="noopener noreferrer">X post</a>
								)}
							</div>
						</div>
					</aside>
				)}
			</section>

			<section class="shelf">
				<div class="section-header">
					<div>
						<p class="eyebrow">Project shortlist</p>
						<h2>Open tabs worth keeping.</h2>
					</div>
					<a class="link-more" href="/work">All work</a>
				</div>
				<div class="shortlist">
					{
						featuredProjects.map((project, index) => (
							<a href={`/work/${project.id}/`}>
								<span class="number">0{index + 1}</span>
								<div>
									<h3>{project.data.title}</h3>
									<p>{project.data.description}</p>
								</div>
								<span class="area">{project.data.area ?? project.data.status}</span>
								<span class="arrow" aria-hidden="true">-&gt;</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="field-grid" aria-label="Current work">
				<div class="panel dark">
					<p class="eyebrow">Currently</p>
					<h2>Production backend by day, AI product lab by night.</h2>
					<div class="now-list">
						<div>
							<span>Work</span>
							<p>Lead SDE at Housing.com / REA India on monetization and lead-generation systems.</p>
						</div>
						<div>
							<span>AI</span>
							<p>TokenOps for LLM routing, governance, budgets, and audit visibility.</p>
						</div>
						<div>
							<span>Training</span>
							<p>RepWise and Zone2Coach for real-time coaching loops.</p>
						</div>
					</div>
				</div>
				<div class="panel">
					<p class="eyebrow">Operating notes</p>
					<h2>What I care about</h2>
					<p>
						Clear system boundaries, measurable product impact, fewer clever abstractions, and tools that
						people actually return to after the demo ends.
					</p>
					<p>
						The personal-site references pushed this page away from a generic portfolio and toward a living
						shelf: visual proof, status, work history, and rough edges intact.
					</p>
				</div>
			</section>

			<section class="section note-strip">
				<div>
					<p class="eyebrow">Field log</p>
					<h2>Build notes, experiments, and things I keep learning.</h2>
				</div>
				<p>
					Browse the <a href="/learnings">learning log</a>, the
					<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">GitHub profile</a>, or the full
					<a href="/work">work shelf</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
