---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import {
	SITE_DESCRIPTION,
	SITE_EMAIL,
	SITE_GITHUB,
	SITE_LINKEDIN,
	SITE_OWNER,
	SITE_TITLE,
	SITE_X,
} from '../consts';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const featuredIds = ['repwise', 'tokenops', 'zone2coach'];
const featuredProjects = featuredIds
	.map((id) => projects.find((project) => project.id === id))
	.filter((project) => project !== undefined);
const repwise = projects.find((project) => project.id === 'repwise');
const siteUrl = new URL('/', Astro.site).href;
const sameAs = [SITE_GITHUB, SITE_LINKEDIN, SITE_X];
const jsonLd = [
	{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		name: `${SITE_OWNER} - Lead Backend Engineer and Applied AI Builder`,
		url: siteUrl,
		description: SITE_DESCRIPTION,
		mainEntity: {
			'@type': 'Person',
			name: SITE_OWNER,
			url: siteUrl,
			email: `mailto:${SITE_EMAIL}`,
			jobTitle: 'Lead Software Development Engineer',
			address: {
				'@type': 'PostalAddress',
				addressLocality: 'Noida',
				addressCountry: 'IN',
			},
			sameAs,
			knowsAbout: [
				'Backend platforms',
				'Applied AI systems',
				'LLM gateways',
				'Recommendation systems',
				'Product engineering',
			],
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		name: SITE_TITLE,
		url: siteUrl,
		description: SITE_DESCRIPTION,
		author: {
			'@type': 'Person',
			name: SITE_OWNER,
			url: siteUrl,
		},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ItemList',
		name: 'Sujnesh Mishra project shortlist',
		itemListElement: featuredProjects.map((project, index) => ({
			'@type': 'ListItem',
			position: index + 1,
			url: new URL(`/work/${project.id}/`, Astro.site).href,
			name: project.data.title,
			description: project.data.description,
		})),
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Sujnesh Mishra | Lead Backend Engineer & Applied AI Builder"
			description={SITE_DESCRIPTION}
			image="/repwise-live.jpg"
			imageAlt="RepWise AI workout coach demo by Sujnesh Mishra"
			jsonLd={jsonLd}
		/>
		<style>
			main {
				width: min(100% - 32px, var(--page));
				padding-top: 0;
			}

			.home-intro {
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(260px, 340px);
				gap: 2rem;
				align-items: start;
				padding: 3.5rem 0 2.75rem;
				border-bottom: 1px solid var(--line);
			}

			.intro-copy {
				max-width: 780px;
			}

			.home-intro h1 {
				max-width: 720px;
				font-size: clamp(2.2rem, 4.5vw, 4.2rem);
				line-height: 1.05;
			}

			.home-intro .lede {
				max-width: 680px;
				margin-top: 1rem;
			}

			.prompt {
				margin-bottom: 1rem;
				padding-left: 0.75rem;
				border-left: 3px solid var(--accent);
				color: var(--accent-strong);
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.88rem;
				font-weight: 800;
			}

			.actions {
				display: flex;
				flex-wrap: wrap;
				gap: 1rem;
				margin-top: 1.5rem;
			}

			.status-panel {
				padding: 1rem;
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--panel);
			}

			.status-panel .panel-title {
				margin: 0 0 1rem;
				color: var(--accent-strong);
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.9rem;
				font-weight: 800;
			}

			.status-panel dl {
				display: grid;
				gap: 0.8rem;
				margin: 0;
			}

			.status-panel div {
				display: grid;
				grid-template-columns: 78px 1fr;
				gap: 1rem;
				padding-top: 0.8rem;
				border-top: 1px solid var(--line);
			}

			.status-panel div:first-of-type {
				padding-top: 0;
				border-top: 0;
			}

			.status-panel dt {
				color: var(--muted);
				font-size: 0.78rem;
				font-weight: 800;
				text-transform: uppercase;
			}

			.status-panel dd {
				margin: 0;
				color: var(--ink);
				font-weight: 700;
				line-height: 1.35;
			}

			.shelf {
				padding: 4.5rem 0;
			}

			.shortlist {
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--panel);
				overflow: hidden;
			}

			.shortlist a {
				display: grid;
				grid-template-columns: 58px minmax(0, 1fr) auto auto;
				gap: 1rem;
				align-items: center;
				padding: 1.2rem;
				border-bottom: 1px solid var(--line);
				color: inherit;
				text-decoration: none;
			}

			.shortlist a:last-child {
				border-bottom: 0;
			}

			.shortlist a:hover {
				background: #f5fb41;
			}

			.shortlist .number,
			.shortlist .area {
				color: var(--muted);
				font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
				font-size: 0.82rem;
				font-weight: 800;
				text-transform: uppercase;
			}

			.shortlist h3 {
				margin-bottom: 0.2rem;
				font-size: 1.55rem;
			}

			.shortlist p {
				margin: 0;
			}

			.arrow {
				color: var(--accent-strong);
				font-size: 1.5rem;
				font-weight: 900;
			}

			.field-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
				padding-bottom: 4.5rem;
			}

			.panel {
				padding: 1.25rem;
				border: 1px solid var(--ink);
				border-radius: 8px;
				background: var(--panel);
			}

			.panel.dark {
				background: var(--ink);
			}

			.panel.dark h2,
			.panel.dark p {
				color: white;
			}

			.now-list {
				display: grid;
				gap: 0.75rem;
				margin-top: 1rem;
			}

			.now-list div {
				display: grid;
				grid-template-columns: 120px 1fr;
				gap: 1rem;
				padding-top: 0.75rem;
				border-top: 1px solid rgba(255, 255, 255, 0.16);
			}

			.now-list span {
				color: #8ee0d1;
				font-size: 0.8rem;
				font-weight: 900;
				text-transform: uppercase;
			}

			.note-strip {
				display: grid;
				grid-template-columns: 1.1fr 1fr;
				gap: 1rem;
				padding: 1.4rem;
				border-radius: 8px;
				background: #f59e0b;
				color: #11130f;
			}

			.note-strip h2,
			.note-strip p {
				color: #11130f;
			}

			.note-strip a {
				color: #11130f;
				font-weight: 900;
			}

			@media (max-width: 900px) {
				.home-intro,
				.field-grid,
				.note-strip {
					grid-template-columns: 1fr;
				}

				.status-panel {
					max-width: 520px;
				}
			}

			@media (max-width: 640px) {
				.home-intro {
					padding-top: 2.5rem;
					padding-bottom: 2rem;
				}

				.shortlist a,
				.now-list div,
				.status-panel div {
					grid-template-columns: 1fr;
				}

				.shortlist .area,
				.arrow {
					display: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="home-intro" aria-labelledby="intro-title">
				<div class="intro-copy">
					<p class="prompt">$ whoami</p>
					<h1 id="intro-title">Systems, notes, and useful AI experiments.</h1>
					<p class="lede">
						I'm a lead engineer focused on monetization, recommendations, LLM gateways,
						and coaching apps that move from prototype to production.
					</p>
					<div class="actions">
						<a class="button" href="/work">Work shelf</a>
						{repwise?.data.demoUrl && <a class="button secondary" href={repwise.data.demoUrl} target="_blank" rel="noopener noreferrer">RepWise demo</a>}
						<a class="button secondary" href={`mailto:${SITE_EMAIL}`}>Email</a>
					</div>
				</div>
				<aside class="status-panel" aria-label="Current status">
					<p class="panel-title">now.json</p>
					<dl>
						<div>
							<dt>role</dt>
							<dd>Lead SDE, Housing.com / REA India</dd>
						</div>
						<div>
							<dt>stack</dt>
							<dd>Backend platforms, applied AI, product systems</dd>
						</div>
						<div>
							<dt>shipping</dt>
							<dd>TokenOps, RepWise, Zone2Coach</dd>
						</div>
						<div>
							<dt>base</dt>
							<dd>Noida, India</dd>
						</div>
					</dl>
				</aside>
			</section>

			<section class="shelf">
				<div class="section-header">
					<div>
						<p class="eyebrow">Project shortlist</p>
						<h2>Open tabs worth keeping.</h2>
					</div>
					<a class="link-more" href="/work">All work</a>
				</div>
				<div class="shortlist">
					{
						featuredProjects.map((project, index) => (
							<a href={`/work/${project.id}/`}>
								<span class="number">0{index + 1}</span>
								<div>
									<h3>{project.data.title}</h3>
									<p>{project.data.description}</p>
								</div>
								<span class="area">{project.data.area ?? project.data.status}</span>
								<span class="arrow" aria-hidden="true">-&gt;</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="field-grid" aria-label="Current work">
				<div class="panel dark">
					<p class="eyebrow">Currently</p>
					<h2>Production backend by day, AI product lab by night.</h2>
					<div class="now-list">
						<div>
							<span>Work</span>
							<p>Lead SDE at Housing.com / REA India on monetization and lead-generation systems.</p>
						</div>
						<div>
							<span>AI</span>
							<p>TokenOps for LLM routing, governance, budgets, and audit visibility.</p>
						</div>
						<div>
							<span>Training</span>
							<p>RepWise and Zone2Coach for real-time coaching loops.</p>
						</div>
					</div>
				</div>
				<div class="panel">
					<p class="eyebrow">Operating notes</p>
					<h2>What I care about</h2>
					<p>
						Clear system boundaries, measurable product impact, fewer clever abstractions, and tools that
						people actually return to after the demo ends.
					</p>
					<p>
						The personal-site references pushed this page away from a generic portfolio and toward a living
						shelf: visual proof, status, work history, and rough edges intact.
					</p>
				</div>
			</section>

			<section class="section note-strip">
				<div>
					<p class="eyebrow">Field log</p>
					<h2>Build notes, experiments, and things I keep learning.</h2>
				</div>
				<p>
					Browse the <a href="/learnings">learning log</a>, the
					<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">GitHub profile</a>, or the full
					<a href="/work">work shelf</a>.
				</p>
			</section>
		</main>
		<Footer />
	</body>
</html>
