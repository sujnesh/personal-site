---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>About</h1>
			<p>
				I am Sujnesh, and this site is my personal log of building, learning, and sharing ideas in public.
			</p>
			<p>
				When I work on something interesting, I document it here so I can track progress and help others who
				are on a similar path.
			</p>
			<h2>What You Will Find Here</h2>
			<ul>
				<li>Project writeups and practical build notes</li>
				<li>Blog posts around tech, growth, and systems</li>
				<li>Learning journals from books, experiments, and courses</li>
			</ul>
		</main>
		<Footer />
	</body>
</html>
