---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AVATAR, SITE_DESCRIPTION, SITE_GITHUB, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			.about-grid {
				display: grid;
				grid-template-columns: 1fr 280px;
				gap: 2rem;
				align-items: start;
			}

			.portrait {
				padding: 0.6rem;
				border: 1px solid var(--line);
				border-radius: 8px;
				background: var(--panel);
			}

			.portrait img {
				display: block;
				width: 100%;
			}

			.list {
				display: grid;
				gap: 1rem;
				margin-top: 2rem;
			}

			@media (max-width: 760px) {
				.about-grid {
					grid-template-columns: 1fr;
				}

				.portrait {
					max-width: 260px;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="about-grid">
				<div>
					<p class="eyebrow">About</p>
					<h1>I build backend platforms and applied AI systems.</h1>
					<p class="lede">
						I am a lead software engineer with 8 years across revenue-critical backend platforms,
						recommendation systems, developer workflows, and AI products.
					</p>
					<div class="list">
						<div class="card">
							<h2>Platform work</h2>
							<p>
								At Housing.com / REA India, I work on monetization and lead-generation systems:
								paid owner flows, package recommendations, checkout integrations, CRM workflows,
								and high-volume lead paths.
							</p>
						</div>
						<div class="card">
							<h2>Applied AI</h2>
							<p>
								I build small, useful AI systems like TokenOps for LLM governance and routing, RepWise
								for workout coaching, and workflow automations that make engineering teams faster.
							</p>
						</div>
						<div class="card">
							<h2>Engineering style</h2>
							<p>
								I prefer boring reliability, measurable product impact, and fast feedback loops. Most
								public code lives on
								<a href={SITE_GITHUB} target="_blank" rel="noopener noreferrer">GitHub</a>.
							</p>
						</div>
					</div>
				</div>
				<aside class="portrait" aria-label="Profile photo">
					<img src={SITE_AVATAR} alt="Sujnesh Mishra" width="280" height="280" loading="lazy" />
				</aside>
			</section>
		</main>
		<Footer />
	</body>
</html>
